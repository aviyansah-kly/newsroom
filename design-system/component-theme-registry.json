{
  "version": "3.1.0-phase3-preview",
  "status": "phase3-qa-only",
  "themeScope": "html[data-theme=\"dark\"]",
  "sourceOfTruth": "styles/newsroom-theme-tokens.css",
  "precedence": [
    "styles/newsroom-design-system.css",
    "styles/newsroom-dark-mode.css",
    "styles/newsroom-dark-mode-editor.css",
    "styles/newsroom-theme-tokens.css",
    "styles/newsroom-theme-components.css"
  ],
  "rule": "Semantic tokens are edited once; add each new component to this registry and to component-contract Playwright tests. Never copy literal light hex rules into new components.",
  "tokens": {
    "app": "--nr-ui-app",
    "navigation": "--nr-ui-navigation",
    "panel": "--nr-ui-panel",
    "canvas": "--nr-ui-canvas",
    "raised": "--nr-ui-raised",
    "control": "--nr-ui-control",
    "hover": "--nr-ui-hover",
    "text": "--nr-ui-text",
    "secondary": "--nr-ui-secondary",
    "muted": "--nr-ui-muted",
    "divider": "--nr-ui-divider",
    "sectionDivider": "--nr-ui-section-divider",
    "cardBorder": "--nr-ui-card-border",
    "inputBorder": "--nr-ui-input-border",
    "focus": "--nr-ui-focus",
    "toggleOffTrack": "--nr-ui-toggle-off-track",
    "toggleOffBorder": "--nr-ui-toggle-off-border",
    "toggleOn": "--nr-ui-toggle-on-track",
    "toggleThumb": "--nr-ui-toggle-thumb",
    "warningBg": "--nr-ui-warning-bg",
    "successBg": "--nr-ui-success-bg",
    "purpleBg": "--nr-ui-purple-bg",
    "tabActiveBg": "--nr-ui-tab-active-bg",
    "tabActiveText": "--nr-ui-tab-active-text",
    "tabInactiveText": "--nr-ui-tab-inactive-text",
    "tabActiveIndicator": "--nr-ui-tab-active-indicator",
    "toolbarIcon": "--nr-ui-toolbar-icon",
    "placeholder": "--nr-ui-placeholder",
    "decorativeDivider": "--nr-ui-decorative-divider",
    "blockSurface": "--nr-ui-block-surface",
    "blockBody": "--nr-ui-block-body",
    "blockHeader": "--nr-ui-block-header",
    "blockTitle": "--nr-ui-block-title",
    "blockMeta": "--nr-ui-block-meta",
    "blockPlaceholder": "--nr-ui-block-placeholder",
    "navHoverBg": "--nr-ui-nav-hover-bg",
    "navHoverText": "--nr-ui-nav-hover-text",
    "navActiveBg": "--nr-ui-nav-active-bg",
    "navActiveText": "--nr-ui-nav-active-text",
    "iconBoxBg": "--nr-icon-box-bg",
    "iconBoxBorder": "--nr-icon-box-border",
    "iconBoxInk": "--nr-icon-box-ink",
    "iconBoxRadius": "--nr-icon-box-radius",
    "sidebarCollapseIconSize": "--nr-sidebar-collapse-icon-size",
    "navigationFontSize": "--nr-font-size-navigation",
    "reviewRing": "--nr-ui-review-ring",
    "reviewRingSoft": "--nr-ui-review-ring-soft"
  },
  "components": [
    {
      "id": "app-shell",
      "owner": "Global",
      "selectors": [
        ".topbar",
        ".context",
        ".alt-writing-card"
      ],
      "tokenRoles": [
        "navigation",
        "panel",
        "canvas",
        "divider"
      ],
      "qa": [
        "initial-editor",
        "responsive"
      ]
    },
    {
      "id": "richtext-block",
      "owner": "Editor Workspace",
      "selectors": [
        ".alt-content-card",
        ".alt-content-card-body",
        ".alt-mini-editor",
        ".classic-toolbar",
        "#tiptap-editor",
        ".alt-mini-toolbar",
        ".alt-mini-toolbar button",
        ".classic-toolbar button",
        ".toolbar-sep"
      ],
      "tokenRoles": [
        "canvas",
        "raised",
        "divider",
        "text",
        "toolbarIcon",
        "decorativeDivider",
        "placeholder",
        "blockSurface",
        "blockBody",
        "blockHeader",
        "blockTitle",
        "blockMeta",
        "cardBorder"
      ],
      "qa": [
        "insert-text-block",
        "sticky-toolbar",
        "expanded-dynamic-block-contrast",
        "soft-section-separators",
        "heading-contrast",
        "card-outer-vs-inner-surface"
      ]
    },
    {
      "id": "media-block",
      "owner": "Editor Workspace",
      "selectors": [
        ".alt-inline-media-preview",
        ".alt-preview-empty-state",
        ".alt-card-field input",
        ".alt-standings-card",
        ".alt-standings-select",
        ".alt-media-drop",
        ".alt-media-preview-card",
        ".alt-page-card",
        ".alt-page-line"
      ],
      "tokenRoles": [
        "raised",
        "inputBorder",
        "muted",
        "decorativeDivider",
        "placeholder",
        "blockTitle",
        "blockMeta",
        "blockPlaceholder",
        "cardBorder"
      ],
      "qa": [
        "video-empty",
        "embed-empty",
        "image-empty",
        "standings",
        "media-empty-actions",
        "page-break",
        "placeholder-headings",
        "image-empty-readability"
