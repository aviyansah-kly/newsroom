      "tokenRoles": [
        "panel",
        "control",
        "divider"
      ],
      "qa": [
        "expand-label",
        "distribution-flags"
      ]
    },
    {
      "id": "seo-panel",
      "owner": "Right Panel > SEO",
      "selectors": [
        "#seoPane",
        ".seo-auto-row",
        ".seo-readiness",
        ".alt-slug-card",
        ".seo-auto-toggle"
      ],
      "tokenRoles": [
        "panel",
        "canvas",
        "successBg",
        "inputBorder"
      ],
      "qa": [
        "seo-tab",
        "custom-slug",
        "ai-suggestions"
      ]
    },
    {
      "id": "publish-modal",
      "owner": "Review & Publish",
      "selectors": [
        "#altValidationModal",
        ".nr-review-schedule",
        ".schedule-fields.show",
        ".schedule-control input",
        ".schedule-summary"
      ],
      "tokenRoles": [
        "panel",
        "canvas",
        "raised",
        "successBg",
        "divider"
