        ".switch-track",
        ".switch input"
      ],
      "tokenRoles": [
        "toggleOffTrack",
        "toggleOffBorder",
        "toggleOn",
        "toggleThumb",
        "focus"
      ],
      "qa": [
        "on",
        "off",
        "focus",
        "disabled"
      ]
    },
    {
      "id": "category-tags",
      "owner": "Editorial",
      "selectors": [
        ".alt-category-tree-popover",
        ".alt-category-tree-search",
        ".alt-tag-lookup",
        ".tag-chip"
      ],
      "tokenRoles": [
        "panel",
        "raised",
        "inputBorder",
        "purpleBg"
      ],
      "qa": [
        "category-open",
        "tag-search",
        "tag-ai"
