      "tokenRoles": [
        "panel",
        "raised",
        "divider"
      ],
      "qa": [
        "picker-open",
        "gallery",
        "upload",
        "details"
      ]
    },
    {
      "id": "dashboard",
      "owner": "Dashboard",
      "selectors": [
        ".dashboard-quick",
        ".dashboard-open"
      ],
      "tokenRoles": [
        "control",
        "divider"
      ],
      "qa": [
        "dashboard-route"
      ]
    },
    {
      "id": "article-list",
      "owner": "Articles",
      "selectors": [
        ".article-row",
        ".article-toolbar",
        ".article-status-pill",
        ".article-preview-btn"
      ],
      "tokenRoles": [
        "panel",
        "divider",
        "successBg",
        "warningBg"
      ],
      "qa": [
        "article-list",
        "status-pills",
        "tabs"
      ]
    },
    {
      "id": "tags-management",
      "owner": "Tags",
      "selectors": [
        ".tag-table",
        ".status-toggle",
        ".row-action"
      ],
      "tokenRoles": [
        "panel",
        "inputBorder",
        "divider"
      ],
      "qa": [
        "tags-route",
        "tag-table",
        "status-toggle"
      ]
    },
    {
      "id": "editor-right-tabs",
      "owner": "Right Panel > Editorial / SEO",
      "selectors": [
        ".context .tabs.article-tabs-promoted button.tab",
        ".context .tabs.article-tabs-promoted button.tab.active",
        ".alt-tab-label"
      ],
      "tokenRoles": [
        "tabActiveBg",
        "tabActiveText",
        "tabInactiveText",
        "tabActiveIndicator",
        "focus"
      ],
      "qa": [
        "tab-inactive-contrast",
        "tab-active-contrast",
        "tab-switch",
        "keyboard-focus",
        "no-active-underline",
        "filled-active-only"
      ]
    },
    {
      "id": "editor-block-actions",
      "owner": "Editor Workspace > Add Content",
      "selectors": [
        ".alt-content-card-head button",
        ".alt-content-actions button",
        ".alt-editor-section .alt-add-menu button",
        ".alt-add-icon"
      ],
      "tokenRoles": [
        "control",
        "hover",
        "secondary",
        "decorativeDivider"
      ],
      "qa": [
        "add-block",
        "hover",
        "icon-on-neutral"
      ]
    },
    {
      "id": "sidebar-navigation",
      "owner": "Global chrome / Editor and secondary pages",
      "selectors": [
        "#cmsNavDrawer .cms-nav-item",
        ".nr-sidebar .nr-nav-item",
        ".cms-nav-legacy-separator"
      ],
      "tokenRoles": [
        "navHoverBg",
        "navHoverText",
        "navActiveBg",
        "navActiveText",
        "decorativeDivider",
        "focus"
      ],
      "qa": [
        "nav-idle",
        "hover-Video-Galleries",
        "hover-text-and-icon",
        "active-Articles",
        "keyboard-focus",
        "shared-articles-route"
      ]
    },
    {
      "id": "editor-content-divider",
      "owner": "Workspace / Title-ShortDesc-Content",
      "selectors": [
        ".alt-writing-card .alt-editor-section::before"
      ],
      "tokenRoles": [
        "decorativeDivider"
      ],
      "qa": [
        "actual-pseudo-before-1px",
        "no-duplicate-white-hairline",
        "light-mode-unchanged"
      ]
    },
    {
      "id": "editorial-team-picker",
      "owner": "Editor Workspace",
      "selectors": [
        "#infoPane .team-add-panel",
        "#infoPane .team-search-wrap",
        "#infoPane .team-suggestion"
      ],
      "tokenRoles": [
        "panel",
        "raised",
        "text",
        "secondary",
        "hover",
        "inputBorder"
      ],
      "qa": [
        "add-reporter",
        "add-editor",
        "search-suggestion",
        "remove-member",
        "dark-mode",
        "mobile"
      ]
    },
    {
      "id": "shared-icon-box",
      "owner": "Global",
      "selectors": [
        ".alt-add-icon",
        ".alt-content-card-title .icon",
        ".seo-auto-status.seo-icon-slot",
        "#importModal .source-icon"
      ],
      "tokenRoles": [
        "iconBoxBg",
        "iconBoxBorder",
        "iconBoxInk",
        "iconBoxRadius"
      ],
      "qa": [
        "add-content",
        "seo-automated-icon",
        "import-popup",
        "light-dark"
      ]
    },
    {
      "id": "shared-tag-input-behavior",
      "owner": "Editor Workspace",
      "selectors": [
        "#tagInput",
        "#tagSuggestions",
        "#tagList",
        "#nrKeywordInput",
        "#nrKeywordSuggestions",
        "#nrKeywordList"
      ],
      "tokenRoles": [
        "panel",
        "control",
        "hover",
        "text",
        "secondary",
        "inputBorder",
        "iconBoxBg",
        "iconBoxBorder"
      ],
      "qa": [
        "tag-input-unit",
        "tag-input-integration",
        "tags-keywords-isolation",
        "seo-primary-sync",
        "light-dark"
      ],
      "implementation": {
        "model": "scripts/components/tag-input-model.js",
        "keywordAdapter": "scripts/newsroom-editorial-reusable.js",
        "existingTags": "legacy Inline Editor controller; migration pending, do not claim fully consolidated"
      }
    }
  ],
  "protected": [
    "Actual article desktop/mobile preview",
    "Original images and uploaded media",
    "Brand logo assets",
    "Draft or autosave state",
    "Existing Light Mode pixel baseline",
    "Role-based Writer/Editor/Redpel/SEO access controls"
  ],
  "componentStyleSource": "styles/newsroom-theme-components.css",
  "tokenOwnership": {
    "componentSemantics": "styles/newsroom-theme-tokens.css",
    "lightFoundations": "styles/newsroom-design-system.css",
    "darkCompatibility": "styles/newsroom-dark-mode.css",
    "iconBoxes": "styles/newsroom-theme-tokens.css",
    "navigationTypography": "styles/newsroom-shell.css",
    "componentSelectors": "styles/newsroom-theme-components.css"
  },
  "migration": {
    "phase": "Phase 3A isolated shared TagInput model",
    "safety": "No design values changed. No removal of legacy layout/event handlers. Merge only with baseline comparison and browser QA.",
    "doNotMergeWithout": [
      "Light/Dark computed-style parity on Dashboard, Articles, Tags, Editor Workspace",
      "Popups and user flows regressions",
      "Cloudflare build log and preview confirmation"
    ],
    "warning": "Keywords migrated to reusable model; original Tags remains legacy until separate behavior parity migration",
    "gate": [
      "No UI computed-style drift from main",
      "Same TagInput suggestion/search behaviors",
      "SEO primary sync and Tags data isolation",
      "Cloudflare static asset preflight for nested model",
      "Manual live verification before merge"
    ]
  }
}
