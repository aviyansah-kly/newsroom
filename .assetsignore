# Static assets allowlist for Newsroom Worker.
# Keep tests, documentation, source audits, CI files and Wrangler metadata
# OUT of the public asset deployment. Gitignore-style syntax.
*
!/*.html
!/design-system/
!/design-system/foundations/
!/design-system/foundations/tokens.css
!/styles/
!/styles/*.css
!/scripts/
!/scripts/*.js
!/scripts/components/
!/scripts/components/*.js
!/assets/
!/assets/**
!/fonts/
!/fonts/**
!/images/
!/images/**
!/media/
!/media/**
!/favicon.ico
!/robots.txt
!/sitemap.xml
